JWT_SECRET=change-me-to-a-long-random-string
ADMIN_SECRET=change-me-too

FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# n8n webhook URLs — these proxy Drive upload and Sheets append using n8n's
# existing Google OAuth credentials (no service-account key required).
N8N_DRIVE_WEBHOOK_URL=https://automations.streamlite.ca/webhook/imm-drive-upload
N8N_SHEETS_WEBHOOK_URL=https://automations.streamlite.ca/webhook/imm-sheets-append

# Per-tenant config. Add tenants here without redeploying code.
# submissions_spreadsheet_id: the ID of the "IMM5645 Submissions" Google Sheet
#   (find it in the Sheet URL: .../spreadsheets/d/<ID>/edit)
TENANTS_JSON={"patko":{"filled_forms_folder_id":"1rUUpGi3K-bngZR0g-ObfEGROD1J0UEut","submissions_spreadsheet_id":"1ePdkcweeuXq5lZH7Mq0V0KZSJaL8T8BdSsQfFw3GzIE","submissions_sheet_name":"IMM5645 Submissions"}}

# Optional — only needed if we add the free-text /extract endpoint later.
# ANTHROPIC_API_KEY=sk-ant-...
