JWT_SECRET=change-me-to-a-long-random-string
ADMIN_SECRET=change-me-too

FRONTEND_ORIGIN=https://your-frontend.up.railway.app
FRONTEND_BASE_URL=https://your-frontend.up.railway.app

# n8n webhook URLs — these proxy Drive upload and Sheets append using n8n's
# existing Google OAuth credentials (no service-account key required).
N8N_DRIVE_WEBHOOK_URL=https://your-n8n-instance/webhook/imm-drive-upload
N8N_SHEETS_WEBHOOK_URL=https://your-n8n-instance/webhook/imm-sheets-append

# Per-tenant config. Add tenants here without redeploying code.
# submissions_spreadsheet_id: the ID of the "IMM5645 Submissions" Google Sheet
#   (find it in the Sheet URL: .../spreadsheets/d/<ID>/edit)
TENANTS_JSON={"tenant-slug":{"filled_forms_folder_id":"<google-drive-folder-id>","submissions_spreadsheet_id":"<google-sheet-id>","submissions_sheet_name":"IMM5645 Submissions"}}
