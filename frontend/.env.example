JWT_SECRET=must-match-backend
ADMIN_SECRET=must-match-backend

# URL the browser uses to reach the FastAPI backend.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# URL printed in admin issue-link responses.
NEXT_PUBLIC_FRONTEND_BASE_URL=http://localhost:3000

# GeoNames username for city autocomplete (free at https://www.geonames.org/login).
# Falls back to a hard-coded default if unset; set this on Railway/Vercel so
# requests aren't attributed to the default account.
NEXT_PUBLIC_GEONAMES_USERNAME=rogerdt69
